// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  TEACHER
  SMM
  STUDENT
  MENTOR
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  VOUCHER_CHECK
  SUCCESS
  ARCHIVED
}

enum EmploymentStatus {
  employed
  unemployed
  UNEMPLOYED
  EMPLOYED_OFFICIAL
  EMPLOYED_UNOFFICIAL
  STUDENT
  student
  STUDENT_EXTERNAL
  SCHOOL_STUDENT
  HOUSEWIFE
  housewife
}

enum CourseInterest {
  VIDEOGRAPHY
  VIDEO_EDITING
  SMM
  TARGET_PRO
  COMPUTER_GRAPHICS
  COMPUTER_LITERACY
  GRAPHIC_DESIGN
  WEB_DEVELOPMENT
  PYTHON
  AUTOCAD
  THREE_D_MAX
  CYBERSECURITY
  OTHER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true)
  workingHours String?  @default("09:00 - 18:00")
  bio          String?
  phone        String?
  nickname     String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads    Lead[]    @relation("AssignedLeads")
  comments Comment[]
  tasks    Task[]    @relation("OperatorTasks")
  reports  Report[]  @relation("UserReports")

  // LMS new relations
  enrollments       Enrollment[]
  homeworks         Homework[]        @relation("StudentHomeworks")
  reviewedHomeworks Homework[]        @relation("MentorReviews")
  sessions          DeviceSession[]
  coins             CoinTransaction[]
  teacherCourses    Course[]          @relation("CourseTeacher")

  @@map("users")
}

model Lead {
  id               String           @id @default(cuid())
  name             String
  phone            String
  phone2           String?
  courseInterest   String           @default("Boshqa")
  employmentStatus String           @default("Ishsiz")
  isGrantEligible  Boolean          @default(false)
  status           LeadStatus       @default(NEW)
  source           String?          @default("manual")
  nextContactDate  DateTime?
  slaDeadline      DateTime?
  slaBreached      Boolean          @default(false)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])
  assignedToId String?

  comments Comment[]

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([nextContactDate])
  @@map("leads")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId   String
  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  @@index([leadId])
  @@index([createdAt])
  @@map("comments")
}

model Setting {
  id               String   @id @default(cuid())
  key              String   @unique
  value            String
  description      String?
  updatedAt        DateTime @updatedAt

  @@map("settings")
}

model Task {
  id             String    @id @default(cuid())
  title          String
  description    String
  isCompleted    Boolean   @default(false)
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  dueDate        DateTime?
  attachmentUrls String[]  @default([])
  
  assignedToId String
  assignedTo   User      @relation("OperatorTasks", fields: [assignedToId], references: [id], onDelete: Cascade)

  // Report fields
  reportText   String?
  completedAt  DateTime?

  @@index([assignedToId])
  @@index([isCompleted])
  @@map("tasks")
}

model Report {
  id             String   @id @default(cuid())
  type           String   // "DAILY" or "WEEKLY"
  content        String
  createdAt      DateTime @default(now())
  attachmentUrls String[] @default([])
  
  authorId  String
  author    User     @relation("UserReports", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("reports")
}

// ==========================================
// KASBTECH AKADEMIYASI LMS MODELLARI
// ==========================================

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum HomeworkStatus {
  PENDING
  APPROVED
  REJECTED
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  thumbnail   String?
  price       Decimal  @db.Decimal(10, 2)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  enrollments Enrollment[]
  teacherId   String?
  teacher     User?    @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([isPublished])
  @@index([teacherId])
  @@map("courses")
}

model Module {
  id        String   @id @default(cuid())
  title     String
  order     Int      // Modul tartib raqami
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id          String     @id @default(cuid())
  title       String
  description String?
  videoUrl    String     // Bunny.net Stream Video ID
  duration    Int        // Sekundlarda
  order       Int        // Dars tartib raqami
  dripDays    Int        @default(0) // Ro'yxatdan o'tgandan keyin necha kundan so'ng dars ochilishi
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  homeworks   Homework[]
  quizzes     Quiz[]

  @@index([moduleId])
  @@map("lessons")
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  Int      @default(0) // O'zlashtirish foizi (0-100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("enrollments")
}

model Homework {
  id             String         @id @default(cuid())
  lessonId       String
  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId      String
  student        User           @relation("StudentHomeworks", fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl        String?        // Yuklangan fayl linki (ZIP yoki PDF)
  textResponse   String?        // Talabaning matnli javobi
  status         HomeworkStatus @default(PENDING)
  grade          Int?           // Baholash balli (0-100)
  feedback       String?        // Mentor fikr-mulohazasi
  reviewerId     String?        // Tekshirgan mentor
  reviewer       User?          @relation("MentorReviews", fields: [reviewerId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("homeworks")
}

model Quiz {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Json     // Savollar ro'yxati (JSON formatida)
  passScore Int      @default(70) // O'tish foizi

  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId String
  score     Int      // To'plangan foiz
  passed    Boolean
  createdAt DateTime @default(now())

  @@map("quiz_attempts")
}

model DeviceSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  deviceInfo   String?  // Brauzer va operatsion tizim ma'lumotlari
  ipAddress    String?
  lastActiveAt DateTime @default(now())

  @@index([userId])
  @@index([lastActiveAt])
  @@map("device_sessions")
}

model Transaction {
  id            String        @id @default(cuid())
  userId        String
  amount        Decimal       @db.Decimal(10, 2)
  paymentSystem String        // "PAYME", "CLICK", "UZUM"
  status        PaymentStatus @default(PENDING)
  systemTxId    String?       @unique // To'lov tizimidan kelgan tranzaksiya ID
  createdAt     DateTime      @default(now())

  @@map("transactions")
}

model CoinTransaction {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Int      // Musbat (koin qo'shilishi) yoki manfiy (koin sarflanishi)
  type        String   // "HW_SUBMISSION", "QUIZ_PASS", "STORE_PURCHASE"
  description String?
  createdAt   DateTime @default(now())

  @@map("coin_transactions")
}


